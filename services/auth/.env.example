# auth-service — скопируйте в .env рядом с запуском (в git не попадает).
# Значения ниже = дев-дефолты из internal/config.

ENV=dev
SERVICE_NAME=auth
LOG_LEVEL=info
HTTP_PORT=8081

# Внимание: если нативный PostgreSQL занимает 5432 — используйте порт из
# deploy/compose/.env (на этой машине 55432).
POSTGRES_DSN=postgres://rosterra:rosterra@localhost:55432/rosterra?sslmode=disable
REDIS_ADDR=localhost:6379
NATS_URL=nats://localhost:4222

# Seed приватного ключа Ed25519 (64 байта, hex). Без него — эфемерный ключ:
# JWKS меняется после рестарта, все access-токены недействительны.
# Сгенерировать: go run - <<'EOF' (32 байта crypto/rand в hex)
JWT_SEED=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

ACCESS_TTL=15m
REFRESH_TTL=12h
REFRESH_TTL_LONG=720h
RELAY_INTERVAL=1s
