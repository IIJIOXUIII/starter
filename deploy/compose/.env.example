# Скопируйте в .env рядом с docker-compose.dev.yml при необходимости переопределить порты/пароли.
# В git попадает только этот файл-шаблон; реальные .env игнорируются.

POSTGRES_USER=rosterra
POSTGRES_PASSWORD=rosterra
POSTGRES_DB=rosterra
# Если на машине уже стоит нативный PostgreSQL (5432 занят) — поменяйте
# на 55432 и создайте deploy/compose/.env (в git не попадает).
POSTGRES_PORT=5432

REDIS_PORT=6379

NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
