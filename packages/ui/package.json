{
  "name": "@rosterra/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook": "concurrently -k -s first \"storybook dev -p 6006 --ci --no-open\" \"wait-on tcp:127.0.0.1:6006 && test-storybook\"",
    "test:storybook:visual": "storybook build && concurrently -k -s first \"http-server storybook-static -p 6007 -s\" \"wait-on tcp:127.0.0.1:6007 && playwright test\""
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@rosterra/eslint-config": "workspace:*",
    "@rosterra/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-docs": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@storybook/test-runner": "^0.20.0",
    "@storybook/vue3": "^8.6.0",
    "@storybook/vue3-vite": "^8.6.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.0.0",
    "eslint": "^9.30.0",
    "http-server": "^14.1.0",
    "jsdom": "^26.0.0",
    "storybook": "^8.6.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^8.0.0"
  }
}
